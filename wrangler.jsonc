{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wherethemoneywent",
  "compatibility_date": "2026-10-01",
  // A few lines that redirect www to the apex; see worker/index.ts.
  "main": "worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "wherethemoneywent.com", "custom_domain": true },
    { "pattern": "www.wherethemoneywent.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker before matching assets, or www requests for real pages
    // would be served directly and never redirected.
    "run_worker_first": true,
    // Unknown paths (e.g. a city not in the registry) get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
