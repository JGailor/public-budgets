// Static assets only: no Worker script runs. Cloudflare serves dist/ directly.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "public-budgets",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // Unknown paths (e.g. a city not in the registry) get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
