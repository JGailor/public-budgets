---
/**
 * Your Ballot (D6): what the city's own plan says happens if the November sales
 * tax passes or fails. Strictly neutral: both outcomes come from one builder in
 * src/lib/ballot.ts and render through the same markup below, with the same
 * colors and weight. Results are a data change in ballot.json (status).
 */
import SourceChip from '../../../../components/SourceChip.astro';
import Base from '../../../../layouts/Base.astro';
import { ballotFileFor, ballotPage, type Outcome } from '../../../../lib/ballot';
import { budgetFor } from '../../../../lib/budget';
import { shortNames } from '../../../../lib/departments';
import { cityStaticPaths, type City } from '../../../../lib/cities';
import { shortMoney } from '../../../../lib/format';

export const getStaticPaths = cityStaticPaths;

const { city } = Astro.props as { city: City };
const budget = budgetFor(city)!;
const p = ballotPage(budget, ballotFileFor(city.path), shortNames(city.path, budget));
const t = p.salesTax.fact;
const bond = p.bond.fact;
const pct = (v: number) => `${+(v * 100).toFixed(2)}%`;
const range = (lo: number, hi: number) => `$${(lo / 1e6).toFixed(1)}–${(hi / 1e6).toFixed(1)}M`;
const millions = (v: number) => `$${+(v / 1e6).toFixed(1)}M`;
const fte = (v: number) => Math.round(v).toLocaleString('en-US');
const committee = (p.plan.committee ?? '').replace(/\bCmte\b/, 'Committee');
const billions = (lo: number, hi: number) => `$${+(lo / 1e9).toFixed(2)}–${+(hi / 1e9).toFixed(2)}B`;
const thresholdLabel = (s: string) => (s === '2/3' ? 'Two-thirds vote' : s.charAt(0).toUpperCase() + s.slice(1));
const resultLabel: Record<Outcome, string> = { passes: '…passes', fails: '…fails' };
const people = (filled: number) => Array.from({ length: p.pictogramSlots }, (_, i) => i < filled);
const list = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}`);
const planDate = new Date(`${p.plan.date}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title={`Your ballot · ${city.name}`} city={city} description={`What ${city.name}'s own budget plan says happens if the ${t.election} sales tax passes, and if it fails.`}>
  <div class="ballot-page wrap" data-result={p.state.result ?? 'pending'}>
    <section class="intro">
      <p class="eyebrow">{p.state.eyebrow}</p>
      <h1>{p.state.heading}</h1>
      <p class="lede">{p.state.lede}</p>
    </section>

    <ul class="measures" role="list">
      <li class="card measure">
        <p class="kicker">Measure · {thresholdLabel(t.threshold)}</p>
        <h2>{pct(t.rate)} local sales tax</h2>
        <p>
          Would raise about {range(t.revenueLow, t.revenueHigh)} a year and bring {city.name}'s sales-tax rate to {pct(t.newRate)}. The city's
          FY27-28 plan was built in two versions, one for each outcome.
        </p>
        <SourceChip city={city} figure={p.salesTax.figure} />
      </li>
      <li class="card measure">
        <p class="kicker">Measure · {thresholdLabel(bond.threshold)}</p>
        <h2>{millions(bond.amount)} infrastructure bond</h2>
        <p>
          Borrowing for streets, buildings and parks, repaid by a {bond.repaidBy}. It doesn't touch the operating gap, but it targets an
          estimated {billions(p.bond.backlog.ref.low, p.bond.backlog.ref.high)} repair backlog.
        </p>
        <span class="chip-row"><SourceChip city={city} figure={p.bond.figure} /><SourceChip city={city} figure={p.bond.backlog} /></span>
      </li>
    </ul>

    <section class="scenarios-section" aria-labelledby="scenarios-h">
      <p class="eyebrow">If the sales tax…</p>
      <h2 id="scenarios-h" class="section-h">Same budget gap, two different sets of cuts.</h2>
      <ul class="scenarios" role="list">
        {
          p.scenarios.map((s) => (
            <li class="card scenario" data-outcome={s.outcome}>
              <h3 class="scenario-h">
                {resultLabel[s.outcome]}
                {p.state.result === s.outcome && <span class="badge">Result</span>}
              </h3>
              <div class="scenario-body">
                <p class="big">
                  <span class="num big-n">{s.positions.total}</span>
                  <span class="big-l">
                    positions eliminated
                    <span class="sub">
                      {s.positions.vacant} vacant · {s.positions.filled} filled (layoffs) <SourceChip city={city} figure={s.positions.figure} />
                    </span>
                  </span>
                </p>
                <p class="pict-label">People laid off</p>
                <div class="pict" role="img" aria-label={`${s.positions.filled} people laid off, out of ${p.pictogramSlots} shown`}>
                  {people(s.positions.filled).map((on) => (
                    <span class:list={['person', { on }]} />
                  ))}
                </div>
                <dl class="facts">
                  <div>
                    <dt>Department cuts</dt>
                    <dd>
                      {shortMoney(s.cuts.value)} ({(s.cuts.pct * 100).toFixed(1)}% of baseline) <SourceChip city={city} figure={s.cuts.figure} />
                    </dd>
                  </div>
                  <div>
                    <dt>City workforce after FY27</dt>
                    <dd>
                      <span class="num">{fte(s.workforce.after)}</span> FTE (from <span class="num">{fte(s.workforce.before)}</span>){' '}
                      <SourceChip city={city} figure={s.workforce.figure} />
                    </dd>
                  </div>
                  <div>
                    <dt>{s.fireStation.label}</dt>
                    <dd>
                      {s.fireStation.text}
                      <span class="reported">
                        as reported{' '}
                        {s.fireStation.sources.map((id) => (
                          <SourceChip city={city} source={id} />
                        ))}
                      </span>
                    </dd>
                  </div>
                </dl>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="footnote">
      Note: even if the tax passes, the city's FY27 plan applies the first year of tax money ({shortMoney(p.salesTax.bridge.value)}) as a one-time
      bridge to soften {list(p.softened)} cuts, while ongoing revenue ramps up. Figures come from the {planDate} {committee} plan and may
      have changed at adoption. <SourceChip city={city} figure={p.salesTax.bridge} />
    </p>
  </div>
</Base>

<style>
  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--bay);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .card {
    background: var(--card);
    border-radius: 0.875rem;
    box-shadow: 0 1px 2px rgb(22 25 29 / 0.06), 0 8px 24px rgb(22 25 29 / 0.06);
  }
  .intro {
    padding-block: clamp(2rem, 5vw, 3.5rem) 2rem;
  }
  h1 {
    margin: 0;
    max-width: 52rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
  }
  .lede {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  ul[role='list'] {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Both measures and both scenarios: same grid, same card, same accent. */
  .measures,
  .scenarios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
  }
  .measure {
    padding: 1.75rem;
    border-top: 6px solid var(--bay);
  }
  .kicker {
    margin: 0 0 0.5rem;
    color: var(--bay);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .measure h2 {
    margin: 0 0 0.75rem;
    font-size: 1.75rem;
  }
  .measure p:not(.kicker) {
    max-width: 30rem;
    margin: 0 0 1rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .chip-row {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .scenarios-section {
    padding-block: 3.5rem 2rem;
  }
  .section-h {
    margin: 0 0 1.75rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .scenario {
    overflow: hidden;
  }
  .scenario-h {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    padding: 1rem 1.75rem;
    background: var(--bay-light);
    font-size: 1.75rem;
  }
  .badge {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--bay);
    color: #fff;
    font: 800 0.75rem/1.2 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .scenario-body {
    padding: 1.25rem 1.75rem 1.75rem;
  }
  .big {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin: 0 0 1.25rem;
  }
  .big-n {
    font: 800 3.5rem/1 var(--font-sans);
  }
  .big-l {
    display: grid;
    color: var(--muted);
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .sub {
    font-weight: 400;
    font-size: 0.875rem;
  }
  .pict-label {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pict {
    display: grid;
    grid-template-columns: repeat(20, 1fr);
    gap: 0.3rem;
    max-width: 27rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  /* A person: head and shoulders, drawn in CSS so both cards share one shape and color. */
  .person {
    position: relative;
    aspect-ratio: 1 / 1.15;
    background: radial-gradient(circle at 50% 22%, var(--c) 0 22%, transparent 23%),
      radial-gradient(ellipse 48% 42% at 50% 100%, var(--c) 0 98%, transparent 100%);
    --c: var(--rule);
  }
  .person.on {
    --c: var(--ink);
  }
  .facts {
    display: grid;
    gap: 0.875rem;
    margin: 1.25rem 0 0;
  }
  .facts dt {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .facts dd {
    margin: 0.125rem 0 0;
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .reported {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: 0.375rem;
    color: var(--muted);
    font-weight: 400;
    font-size: 0.8125rem;
  }
  .footnote {
    margin: 0 0 3.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    background: #ede8dc;
    line-height: 1.6;
  }
</style>
