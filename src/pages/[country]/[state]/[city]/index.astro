---
/**
 * A city's overview (D1/M1): where every $100 goes, and why there's a gap.
 * Every number comes from overview() in src/lib/overview.ts; tests/dist
 * recomputes the story's checks from budget.json.
 */
import Sourced from '../../../../components/Sourced.astro';
import StepInfo from '../../../../components/StepInfo.astro';
import Term from '../../../../components/Term.astro';
import Waffle from '../../../../components/Waffle.astro';
import Base from '../../../../layouts/Base.astro';
import { budgetFor } from '../../../../lib/budget';
import { CITY_PAGES, cityStaticPaths, type City } from '../../../../lib/cities';
import { familiesFor } from '../../../../lib/families';
import { shortMoney } from '../../../../lib/format';
import { overview } from '../../../../lib/overview';
import { formatValue } from '../../../../lib/receipts';
import { revenueGroupsFor } from '../../../../lib/revenue-groups';

export const getStaticPaths = cityStaticPaths;

const { city } = Astro.props as { city: City };
const budget = budgetFor(city)!;
const families = familiesFor(city, budget);
const o = overview(budget, families, revenueGroupsFor(city, budget));
const has = (slug: string) => CITY_PAGES.some((p) => (p.slug as string) === slug);
const pct = (share: number) => `${Math.round(share * 100)}%`;
const fte = Math.round(o.fte.value).toLocaleString('en-US');

// Mini waterfall geometry: a shared zero line, bars hanging below it.
const wf = (() => {
  let running = 0;
  const lowest = Math.min(...o.waterfall.map((w) => (w.kind === 'total' ? w.value : 0)), 0);
  const scale = 70 / Math.abs(lowest);
  return o.waterfall.map((w) => {
    const [from, to] = w.kind === 'total' ? [0, w.value] : [running, running + w.value];
    if (w.kind === 'total') running = w.value;
    else running += w.value;
    return { ...w, y: 14 + Math.min(-from, -to) * scale, h: Math.max(Math.abs(to - from) * scale, 3) };
  });
})();

// Compounding chart geometry.
const series = o.growth.series;
const top = Math.ceil(series.at(-1)!.spending / 50) * 50;
const X = (year: number) => 40 + (year / (series.length - 1)) * 470;
const Y = (v: number) => 230 - ((v - 100) / (top - 100)) * 200;
const line = (k: 'spending' | 'revenue') => series.map((p, i) => `${i ? 'L' : 'M'}${X(p.year).toFixed(1)} ${Y(p[k]).toFixed(1)}`).join(' ');
const gapArea = `${line('spending')} ${[...series].reverse().map((p) => `L${X(p.year).toFixed(1)} ${Y(p.revenue).toFixed(1)}`).join(' ')} Z`;
const last = series.at(-1)!;
const ticks = [100, 150, 200, 250, 300].filter((v) => v <= top);
const xTicks = [0, Math.floor((series.length - 1) / 2), series.length - 1];
const labelYear = Math.round((series.length - 1) * 0.8);
const gapLabelY = (Y(series[labelYear].spending) + Y(series[labelYear].revenue)) / 2 + 4;
const rate = (r: number) => `${(r * 100).toLocaleString('en-US')}%`;
const g = o.growth.cited;
const numberWords: Record<number, string> = { 10: 'ten' };
const pointsWords: Record<number, string> = { 1.5: 'One and a half' };
const diff = Math.round((g.spendingRate - g.revenueRate) * 1000) / 10;
const pointsText = pointsWords[diff] ?? `${diff.toLocaleString('en-US')}`;
---

<Base title={`${city.name}, ${city.stateCode}`} city={city} description={`Where every $100 of ${city.name}'s budget goes, and why there's a gap. Every number links to the public document it came from.`}>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>Where every $100 of {city.name}'s budget goes.</h1>
      <p class="lede">
        {city.name}'s whole budget for fiscal year 2027 is <Sourced city={city} figure={o.size.allFunds}>{shortMoney(o.size.allFunds.value)}</Sourced>. Most of it
        is set aside for specific uses, like sewers, parking or grants. The <Sourced city={city} figure={o.size.generalFund}
          >{shortMoney(o.size.generalFund.value)}</Sourced
        >{' '}
        <Term city={city} name="General Fund (GF)">General Fund</Term> is the part the Council can spend on anything. This chart shows the{' '}
        <Sourced city={city} figure={o.baseline}>{shortMoney(o.baseline.value)}</Sourced> of it planned for departments, before cuts. Each square is one dollar
        out of every hundred. <span class="hover-hint">Hover a square to see the department.</span><span class="tap-hint">Tap a square.</span>
      </p>
      <!-- Phones: the tour sits above the waffle, which fills a screen (#24). Wide screens show the copy in .hero-more. -->
      <p class="ctas ctas--narrow">
        <a class="btn btn--ink" href="#three-things">Start the 3-minute tour <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={`${city.path}gap/`}>Jump to the {shortMoney(Math.abs(o.gap.value), 0)} gap</a>
      </p>
    </div>

    <div class="hero-waffle">
      <Waffle city={city} shares={o.shares} families={families} />
      <ul class="legend">
        {
          o.familyTotals.map((f) => (
            <li>
              <span class="swatches" aria-hidden="true">
                {f.family.colors.slice(0, 3).map((c) => (
                  <span style={`background:${c}`} />
                ))}
              </span>
              <span class="fam">{f.family.name}</span>
              <span class="dollars num">${f.dollars}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-more">
      <dl class="stats">
        <div>
          <dt>department baseline, FY27</dt>
          <dd class="num"><Sourced city={city} figure={o.baseline}>{shortMoney(o.baseline.value)}</Sourced></dd>
        </div>
        <div>
          <dt>staff positions (FTE), FY27</dt>
          <dd class="num"><Sourced city={city} figure={o.fte}>{fte}</Sourced></dd>
        </div>
        <div>
          <dt>gap the city must close</dt>
          <dd class="num short"><Sourced city={city} figure={o.gap}>{shortMoney(Math.abs(o.gap.value))}</Sourced></dd>
        </div>
      </dl>

      <p class="ctas ctas--wide">
        <a class="btn btn--ink" href="#three-things">Start the 3-minute tour <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={`${city.path}gap/`}>Jump to the {shortMoney(Math.abs(o.gap.value), 0)} gap</a>
      </p>
    </div>
  </section>

  <section id="three-things" class="wrap section">
    <ol class="things">
      <li class="card">
        <p class="n n--bay">1</p>
        <h2>Property tax is the City's biggest source of money.</h2>
        <p class="body">
          About $1 of every ${o.revenue.oneIn} the City collects is property tax. Another {pct(o.revenue.transfer.share)} comes from a tax paid when a home is
          sold.
        </p>
        <div class="mix" role="img" aria-label={`FY2026 General Fund revenue by source: ${o.revenue.mix.map((g) => `${g.name} ${pct(g.share)}`).join(', ')}.`}>
          {o.revenue.mix.map((g) => <span style={`flex:${g.adopted};background:${g.color}`} title={`${g.name}: ${pct(g.share)}`} />)}
        </div>
        <p class="mix-labels">
          <span class="bay">{o.revenue.property.name} {pct(o.revenue.property.share)}</span>
          <span><Sourced city={city} figure={o.revenue.total}>{shortMoney(o.revenue.total.value)}</Sourced> total, FY26</span>
        </p>
        {has('revenue') && <a class="more" href={`${city.path}revenue/`}>Explore revenue <span aria-hidden="true">→</span></a>}
      </li>

      <li class="card">
        <p class="n n--red">2</p>
        <h2>Costs are growing faster than income.</h2>
        <p class="body">
          For {numberWords[g.years] ?? g.years} years, the City's costs grew about <Sourced city={city} figure={o.growth.figure}>{rate(g.spendingRate)}</Sourced>{' '}
          a year and its income about {rate(g.revenueRate)}. So it starts each year short.
        </p>
        <!-- Each bar's value is its own receipt (#29), so the values are HTML buttons over the SVG's top margin. -->
        <ul class="wf-values" style={`--n:${wf.length}`} role="list">
          {
            wf.map((w) => (
              <li class:list={['wf-label', w.kind]}>
                <Sourced city={city} figure={w.figure}>
                  {w.value > 0 ? '+' : ''}
                  {shortMoney(w.value)}
                </Sourced>
              </li>
            ))
          }
        </ul>
        <svg class="mini-wf" viewBox={`0 0 ${o.waterfall.length * 62} 110`} role="img" aria-label={`FY2027 deficit bridge: ${o.waterfall.map((w) => `${w.label} ${formatValue(w.value)}`).join(', ')}.`}>
          <line x1="0" y1="14" x2={o.waterfall.length * 62} y2="14" stroke="var(--muted)" stroke-width="1"></line>
          {
            wf.map((w, i) => (
              <g>
                <rect x={i * 62 + 8} y={w.y} width="46" height={w.h} rx="2" class={`wf-bar wf-bar--${w.kind}`} />
              </g>
            ))
          }
        </svg>
        <!-- One label per bar, in the bars' columns, each with its "what is this?" (#25). -->
        <ul class="wf-names" style={`--n:${wf.length}`} role="list">
          {
            wf.map((w) => (
              <li>
                <span>{w.short}</span>
                <StepInfo city={city} id={`note-overview-${w.key}`} label={w.short} note={w.note} part="button" />
              </li>
            ))
          }
        </ul>
        <div class="wf-notes">{wf.map((w) => <StepInfo city={city} id={`note-overview-${w.key}`} label={w.short} note={w.note} part="panel" />)}</div>
        <a class="more" href={`${city.path}gap/`}>See the gap step by step <span aria-hidden="true">→</span></a>
      </li>

      <li class="card">
        <p class="n n--ink">3</p>
        <h2>The sales-tax vote changes how deep the cuts go.</h2>
        <p class="body">
          <Sourced city={city} figure={o.ballot.withTax}>{o.ballot.withTax.value}</Sourced> positions cut if Measure {o.ballot.salesTaxLetter} passes,{' '}
          <Sourced city={city} figure={o.ballot.withoutTax}>{o.ballot.withoutTax.value}</Sourced> if it fails.
        </p>
        <a class="more" href={`${city.path}${has('ballot') ? 'ballot' : 'gap'}/`}>Compare both outcomes <span aria-hidden="true">→</span></a>
      </li>
    </ol>
  </section>

  <section class="wrap section compounded">
    <div>
      <h2>Small differences, compounded.</h2>
      <p class="body">
        City staff say spending grew about <Sourced city={city} figure={o.growth.figure}>{rate(g.spendingRate)}</Sourced> a year over {numberWords[g.years] ?? g.years} years while revenue
        grew about {rate(g.revenueRate)}. {pointsText} points doesn't sound like much. Compounded over a decade, it adds up to a <Term city={city} name="Structural deficit">structural deficit</Term>.
      </p>
      <p class="illustration-note">
        Illustration: lines show the cited average rates applied to 100, not actual yearly figures. Year-by-year spending for FY22–FY25 isn't in the
        sources.
      </p>
    </div>
    <svg class="growth" viewBox="0 0 640 270" role="img" aria-label={`Illustration: starting from 100, spending growing ${rate(o.growth.cited.spendingRate)} a year reaches ${Math.round(last.spending)} after ${last.year} years; revenue growing ${rate(o.growth.cited.revenueRate)} reaches ${Math.round(last.revenue)}.`}>
      {
        ticks.map((v) => (
          <g>
            <line x1="40" x2="510" y1={Y(v)} y2={Y(v)} stroke="var(--rule)" />
            <text x="32" y={Y(v) + 4} text-anchor="end" class="axis">{v}</text>
          </g>
        ))
      }
      <path d={gapArea} fill="var(--red-light)" opacity="0.8"></path>
      <path d={line('revenue')} fill="none" stroke="var(--bay)" stroke-width="3"></path>
      <path d={line('spending')} fill="none" stroke="var(--red)" stroke-width="3"></path>
      <text x={X(last.year) + 8} y={Y(last.spending) + 4} class="end end--spending">Spending {Math.round(last.spending)}</text>
      <text x={X(last.year) + 8} y={Y(last.revenue) + 4} class="end end--revenue">Revenue {Math.round(last.revenue)}</text>
      <text x={X(labelYear)} y={gapLabelY} class="gap-label" text-anchor="middle">the gap</text>
      {
        xTicks.map((y) => (
          <text x={X(y)} y="256" text-anchor="middle" class="axis">
            Year {y}
          </text>
        ))
      }
    </svg>
  </section>

  <section class="wrap section">
    <div class="trust">
      <div>
        <h2>Don't take our word for it.</h2>
        <p>
          Tap any number to see the exact city document, the date, and the table it came from, with a link to the original.
        </p>
      </div>
      <div>
        <p class="counts">
          {o.sourceIds.length} sources: {o.sourceCounts.city} city documents, {o.sourceCounts.news} news reports
        </p>
        <a class="btn btn--light" href={`${city.path}sources/`}>Browse all sources</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .card {
    background: var(--card);
    border-radius: 0.875rem;
    box-shadow: 0 1px 2px rgb(22 25 29 / 0.06), 0 8px 24px rgb(22 25 29 / 0.06);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0 1.5rem;
    border-radius: var(--radius-pill);
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn--ink {
    background: var(--ink);
    color: #fff;
  }
  .btn--ghost {
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
  }
  .btn--light {
    background: #fff;
    color: var(--bay);
  }

  /* Hero */
  /* Phones: copy, then the waffle, then the stats (M1). Desktop: copy and stats left, waffle right (D1). */
  .hero {
    display: grid;
    grid-template-areas: 'copy' 'waffle' 'more';
    gap: 2rem;
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  /* A grid item's default min-width is its min-content width, so the waffle's open table (#22)
     would stretch the track, and the page, instead of scrolling inside .table-scroll. */
  .hero > * {
    min-width: 0;
  }
  .hero-copy {
    grid-area: copy;
  }
  .hero-waffle {
    grid-area: waffle;
  }
  .hero-more {
    grid-area: more;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  .lede {
    max-width: 32rem;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .tap-hint {
    display: none;
  }
  @media (hover: none) {
    .hover-hint {
      display: none;
    }
    .tap-hint {
      display: inline;
    }
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    margin: 0;
  }
  .stats > div {
    display: flex;
    flex-direction: column;
    padding-inline: 0 clamp(0.75rem, 3vw, 1.5rem);
    margin-inline-end: clamp(0.75rem, 3vw, 1.5rem);
    border-right: 1px solid var(--rule);
  }
  .stats > div:last-child {
    border-right: 0;
  }
  .stats dt {
    order: 2;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .stats dd {
    margin: 0;
  }
  .stats dd.num {
    order: 1;
    font-weight: 800;
    font-size: clamp(1.25rem, 5vw, 2rem);
    line-height: 1.2;
  }
  .stats dd:last-child {
    order: 3;
    margin-top: 0.25rem;
  }
  .short {
    color: var(--red);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
  }
  .ctas--wide {
    display: none;
  }
  .hero-waffle {
    width: 100%;
    max-width: 30rem;
    justify-self: center;
  }
  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .swatches {
    display: flex;
    gap: 2px;
  }
  .swatches span {
    width: 0.5rem;
    height: 0.875rem;
    border-radius: 1px;
  }
  .fam {
    font-weight: 700;
  }
  .dollars {
    margin-inline-start: auto;
    color: var(--muted);
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: 1fr minmax(24rem, 30rem);
      grid-template-areas: 'copy waffle' 'more waffle';
      grid-template-rows: auto 1fr;
      column-gap: 3rem;
      row-gap: 0;
      align-items: start;
    }
    .hero-more {
      margin-top: 2rem;
    }
    .ctas--narrow {
      display: none;
    }
    .ctas--wide {
      display: flex;
    }
  }

  /* Three things */
  .section {
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .things {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .things > li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
  }
  .n {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
  }
  .n--bay {
    color: var(--bay);
  }
  .n--red {
    color: var(--red);
  }
  /* The ballot card: gold means one-time money and red money short; a ballot is neither (#23). */
  .n--ink {
    color: var(--ink);
  }
  .things h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .body {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }
  .mix {
    display: flex;
    gap: 2px;
    height: 2rem;
    margin-top: 0.5rem;
  }
  .mix span {
    border-radius: 2px;
  }
  .mix-labels {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .bay {
    color: var(--bay);
    font-weight: 700;
  }
  .mini-wf {
    width: 100%;
    max-width: 20rem;
    overflow: visible;
  }
  .wf-bar--total {
    fill: var(--red);
  }
  /* Solid, lighter red: adjustments add to the gap but aren't cuts, so no hatch (#25). */
  .wf-bar--cost {
    fill: color-mix(in srgb, var(--red) 65%, white);
  }
  .wf-bar--up {
    fill: var(--bay);
  }
  .wf-bar--one-time {
    fill: var(--gold);
  }
  .wf-names {
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    width: 100%;
    max-width: 20rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .wf-names li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    color: var(--muted);
    font-weight: 700;
    font-size: 0.75rem;
    line-height: 1.2;
    text-align: center;
  }
  .wf-notes {
    max-width: 20rem;
  }
  .wf-notes :global(.info-panel:not([hidden])) {
    margin-top: 0.5rem;
  }
  .wf-values {
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    margin: 0 0 -0.75rem;
    padding: 0;
    list-style: none;
    position: relative;
  }
  .wf-label {
    font: 800 0.6875rem/1.2 var(--font-sans);
    color: var(--red-text);
    text-align: center;
  }
  .wf-label.up {
    color: var(--bay);
  }
  .wf-label.one-time {
    color: #8a5f0b;
  }
  .more {
    margin-top: auto;
    color: var(--bay);
    font-weight: 800;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  /* Small differences, compounded */
  .compounded {
    display: grid;
    gap: 2rem;
  }
  .compounded h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
  }
  .illustration-note {
    margin: 1.5rem 0 0;
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    background: var(--gold-light);
    color: #5c4210;
    font-size: 0.875rem;
  }
  .growth {
    width: 100%;
    overflow: visible;
  }
  .axis {
    font: 600 11px var(--font-sans);
    fill: var(--muted);
  }
  .end {
    font: 800 13px var(--font-sans);
  }
  .end--spending {
    fill: var(--red);
  }
  .end--revenue {
    fill: var(--bay);
  }
  .gap-label {
    font: italic 14px var(--font-serif);
    fill: var(--red);
  }
  @media (min-width: 64rem) {
    .compounded {
      grid-template-columns: 1fr 1.2fr;
      align-items: center;
    }
  }

  /* Trust block */
  .trust {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem 3rem;
    align-items: center;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: 1.125rem;
    background: var(--bay);
    color: #fff;
  }
  .trust h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.125rem);
  }
  .trust p {
    margin: 0.75rem 0 0;
    color: #d7e9e7;
    line-height: 1.6;
  }
  .counts {
    font-weight: 700;
    font-size: 0.875rem;
  }
  .trust .btn {
    margin-top: 1rem;
  }
</style>
