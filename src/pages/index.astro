---
/**
 * The landing page (L1/L2 in #1's mockups). Every number on it is computed
 * from the first city's budget.json via headlines(); tests/dist checks each
 * one against an independent calculation.
 */
import Sourced from '../components/Sourced.astro';
import Waffle from '../components/Waffle.astro';
import Base from '../layouts/Base.astro';
import { budgetFor } from '../lib/budget';
import { CITY_PAGES, cities } from '../lib/cities';
import { familiesFor } from '../lib/families';
import { shortMoney } from '../lib/format';
import { headlines } from '../lib/headlines';
import { SITE } from '../lib/site';

const city = cities[0];
const budget = budgetFor(city)!;
const families = familiesFor(city, budget);
const h = headlines(budget, families);
const pageHref = (slug: string) => `${city.path}${slug}/`;
// The sales-tax question opens the Ballot page; a city without one falls back to The Gap, which also compares both outcomes.
const ballot = CITY_PAGES.some((p) => (p.slug as string) === 'ballot') ? { slug: 'ballot', label: 'Ballot' } : { slug: 'gap', label: 'The Gap' };

const questions = [
  {
    q: 'Where does the money go?',
    a: ['Police and Fire are ', `$${h.safetyPer100}`, ' of every $100.'],
    figure: h.safety,
    href: city.path,
    page: 'Overview',
    tone: 'bay',
  },
  {
    q: 'Why is there a deficit?',
    a: ['A ', shortMoney(Math.abs(h.gap.value)), ' gap after adjustments.'],
    figure: h.gap,
    href: pageHref('gap'),
    page: 'The Gap',
    tone: 'red',
  },
  {
    q: `What if Measure ${budget.documentFacts.salesTaxMeasure.letter}, the sales tax, passes?`,
    a: ['', `${h.positionsWithTax.value}`, ` positions cut instead of ${h.positionsWithoutTax}.`],
    figure: h.positionsWithTax,
    href: pageHref(ballot.slug),
    page: ballot.label,
    // Neutral ink: gold means one-time money and red means money short; neither is a ballot outcome (#23).
    tone: 'ink',
  },
  {
    q: "Who's cutting what?",
    a: ['', shortMoney(h.cuts.value), ` across ${h.departmentsCut} departments.`],
    figure: h.cuts,
    href: pageHref('departments'),
    page: 'Departments',
    tone: 'blue',
  },
];
const requestTemplate = `${SITE.repo}/issues/new`;
---

<Base
  title={SITE.name}
  dataCity={city}
  description={`Your city's budget, finally readable. Explore ${city.name}'s budget in minutes: where every $100 goes, why there's a gap, and who's being asked to cut. Every number links to the public document it came from.`}
  sections={[
    { href: '#cities', label: 'Cities' },
    { href: '#promise', label: 'Our promise' },
    { href: `${city.path}sources/#downloads`, label: 'Data' },
  ]}
>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>{city.name}'s costs keep growing faster than its income.</h1>
      <p class="lede">
        This year that's a <Sourced city={city} figure={h.gap}>{shortMoney(Math.abs(h.gap.value))}</Sourced> gap, closed with cuts, one-time money
        and, if voters approve it, a sales tax.
      </p>
      <p class="ctas">
        <a class="btn btn--bay" href={city.path}>Explore {city.name}'s budget <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#request">Request your city</a>
      </p>
    </div>

    <div class="card city-card">
      <h2 class="card-title">Where every $100 goes</h2>
      <Waffle city={city} shares={h.shares} families={families} />
      <ul class="legend">
        {
          families.list.map((f) => (
            <li>
              <span class="swatch" style={`background:${f.colors[0]}`} aria-hidden="true" />
              {f.name}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap section">
    <h2>Ask {city.name}'s budget anything.</h2>
    <ul class="questions">
      {
        questions.map((x) => (
          <li class={`card question question--${x.tone}`}>
            <h3>{x.q}</h3>
            <p class="answer">
              {x.a[0]}<Sourced city={city} figure={x.figure}>{x.a[1]}</Sourced>{x.a[2]}
            </p>
            <a class="open" href={x.href}>
              Open {x.page} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="cities" class="wrap section">
    <h2>Starting with {city.name}.</h2>
    <div class="cities">
      <a class="card city" href={city.path}>
        <span class="city-head">
          <span class="city-name">{city.name}, {city.state}</span>
          <span class="swatches" aria-hidden="true">
            {h.shares.slice(0, 6).map((s) => <span style={`background:${families.color(s.item.id)}`} />)}
          </span>
        </span>
        <span class="city-meta"><span class="live">Live</span> {budget.notes.coverage} · {h.sourceCount} sources</span>
        <span class="city-path">{city.path.replace(/\/$/, '')} <span aria-hidden="true">→</span></span>
      </a>
      <form id="request" class="request" action={requestTemplate} method="get" target="_blank">
        <h3>Want your city next?</h3>
        <p>Tell us where you live. We prioritize cities by requests.</p>
        <input type="hidden" name="template" value="request-a-city.yml" />
        <input type="hidden" name="title" value="City request" />
        <div class="fields">
          <label><span class="visually-hidden">City</span><input name="city" placeholder="City" autocomplete="address-level2" required /></label>
          <label><span class="visually-hidden">State</span><input name="state" placeholder="State" autocomplete="address-level1" required class="state" /></label>
          <button type="submit" class="btn btn--ink">Request it</button>
        </div>
        <p class="hint">Opens a prefilled request on GitHub.</p>
      </form>
    </div>
  </section>

  <section id="promise" class="wrap section">
    <div class="promise">
      <h2>Our promise</h2>
      <p>
        We're independent and nonpartisan, and we don't take positions on ballot measures. Tap any number to see the page it came from.
        When we find a mistake, we fix it in public.
      </p>
    </div>
  </section>
</Base>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 0 1.5rem;
    border-radius: var(--radius-pill);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .btn--bay {
    background: var(--bay);
    color: #fff;
  }
  .btn--ghost {
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
  }
  .btn--ink {
    border: 0;
    background: var(--ink);
    color: #fff;
    min-height: 2.75rem;
    font-size: 0.9375rem;
  }
  .btn--small {
    min-height: 2.25rem;
    padding: 0 1rem;
    font-size: 0.875rem;
  }
  .card {
    background: var(--card);
    border-radius: 0.875rem;
    box-shadow: 0 1px 2px rgb(22 25 29 / 0.06), 0 8px 24px rgb(22 25 29 / 0.06);
  }

  /* Hero */
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  /* Grid items default to min-width: auto; the waffle must shrink with the column. */
  .hero > * {
    min-width: 0;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    line-height: 1.1;
  }
  .lede {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    line-height: 1.6;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 0;
  }
  .city-card {
    justify-self: center;
    width: 100%;
    max-width: 27rem;
    padding: 1.75rem;
  }
  .card-title {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
  }
  .legend {
    display: grid;
    gap: 0.375rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: 1fr 26rem;
      align-items: start;
    }
    .city-card {
      max-width: none;
    }
  }

  /* Sections */
  .section {
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
  }
  .section > h2 {
    margin: 0 0 2rem;
    font-size: clamp(1.75rem, 3.6vw, 2.375rem);
  }
  .questions {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .question {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.5rem;
    border-top: 0.5rem solid var(--accent);
    overflow: hidden;
  }
  .question--bay {
    --accent: var(--bay);
    --answer: var(--bay);
  }
  .question--red {
    --accent: var(--red);
    --answer: var(--red);
  }
  .question--ink {
    --accent: var(--ink);
    --answer: var(--ink);
  }
  .question--blue {
    --accent: var(--family-safety-2);
    --answer: var(--family-safety-2);
  }
  .question h3 {
    margin: 0;
    font-size: 1.3125rem;
  }
  .answer {
    margin: 0;
    color: var(--answer);
    font-weight: 700;
  }
  .open {
    margin-top: auto;
    color: var(--bay);
    font-weight: 800;
    font-size: 0.875rem;
    text-decoration: none;
  }

  /* Cities */
  .cities {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
  }
  .city {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .city-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .city-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
  }
  .swatches {
    display: flex;
    gap: 0.25rem;
  }
  .swatches span {
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 3px;
  }
  .city-meta {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .live {
    margin-inline-end: 0.5rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--bay-light);
    color: var(--bay);
    font-weight: 800;
  }
  .city-path {
    color: var(--bay);
    font-weight: 700;
    font-size: 0.875rem;
  }
  .request {
    padding: 1.75rem;
    border: 1.5px dashed #bdb6a8;
    border-radius: 0.875rem;
  }
  .request h3 {
    margin: 0;
    font-size: 1.5rem;
  }
  .request p {
    margin: 0.5rem 0 1.25rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .fields label {
    flex: 1 1 9rem;
    display: flex;
  }
  .fields label:has(.state) {
    flex: 0 1 5.5rem;
  }
  .fields input {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
    background: var(--card);
    font: inherit;
  }
  .request .hint {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
  }

  /* Promise */
  .promise {
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: 1.125rem;
    background: var(--bay);
    color: #fff;
  }
  .promise h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.125rem);
  }
  .promise p {
    max-width: 44rem;
    margin: 0.75rem 0 0;
    color: #d7e9e7;
    line-height: 1.6;
  }
</style>
