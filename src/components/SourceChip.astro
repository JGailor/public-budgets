---
/**
 * Source chips for one figure: an S{n} button per source, opening the receipt.
 *   <SourceChip city={city} figure={{ value, label, ref }} />   receipt for a figure
 *   <SourceChip city={city} source="S2" />                     receipt for a whole document
 *   <SourceChip city={city} source="S20" at={{ page, quote }} /> …at the page and sentence a statement comes from
 */
import { budgetFor } from '../lib/budget';
import type { City } from '../lib/cities';
import { figureReceipt, sourceReceipt, sourcesById, type At, type Figure } from '../lib/receipts';
import type { SourceId } from '../data/types';

type Props = { city: City } & ({ figure: Figure; source?: never; at?: never } | { source: SourceId; at?: At; figure?: never });

const { city, figure, source, at } = Astro.props;
const budget = budgetFor(city);
if (!budget) throw new Error(`SourceChip: ${city.path} has no budget data`);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const receipt = figure ? figureReceipt(budget, city, figure, pageUrl) : sourceReceipt(budget, source!, pageUrl, at);
const views = sourcesById(budget);
---

<span class="chips" data-receipt={JSON.stringify(receipt)}>
  {
    receipt.sources.map((id) => {
      const s = views.get(id)!;
      return (
        <button type="button" class:list={['chip', `chip--${s.type}`]} data-source-chip={id} aria-haspopup="dialog" aria-label={s.name}>
          {id}
        </button>
      );
    })
  }
</span>

<style>
  .chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-inline-start: 0.375rem;
    vertical-align: middle;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0 0.5rem;
    border: 0;
    border-radius: var(--radius-pill);
    font: 700 0.6875rem/1 var(--font-sans);
    letter-spacing: 0.02em;
    cursor: pointer;
  }
  /* City documents read as primary: solid bay. News reports read as context: light. */
  .chip--city {
    background: var(--bay);
    color: #fff;
  }
  .chip--news {
    background: var(--bay-light);
    color: var(--bay);
  }
  .chip:hover {
    filter: brightness(1.1);
  }
  .chip--news:hover {
    filter: brightness(0.95);
  }
</style>
